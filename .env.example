# Database (the host name "db" is the Postgres service in docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ecommerce
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ecommerce_test

# Auth
JWT_SECRET=

# Stripe (test mode keys only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

# Where the browser reaches the app (used for Stripe redirect URLs)
FRONTEND_BASE_URL=http://localhost:8000
